# Copy this file to .env and fill in your Splunk Observability Cloud values.
# .env is gitignored so your access token stays out of version control.
#
# SPLUNK_REALM: your o11y cloud realm (e.g. us0, us1, eu0). Leave empty to
# export OTLP to a local Collector instead of sending straight to o11y cloud.
SPLUNK_REALM=us1
# SPLUNK_ACCESS_TOKEN: org access token used to authenticate direct ingest.
SPLUNK_ACCESS_TOKEN=
